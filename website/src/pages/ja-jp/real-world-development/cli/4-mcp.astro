---
const target = `${import.meta.env.BASE_URL}ja-jp/real-world-development/cli/6-mcp-playwright/`;
const canonical = new URL(target, Astro.site).href;
---

<!doctype html>
<html lang="ja-JP" data-pagefind-ignore>
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0;url=${target}`} />
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={canonical} />
    <title>移動したレッスン: Playwright MCP</title>
  </head>
  <body>
    <a href={target}>このレッスンは移動しました。Playwright MCP を使った検証に進んでください。</a>
  </body>
</html>
